# Copy to .env and fill in your values. .env is git-ignored: never commit it.

# Brainy access key, read by tools/export_*.py and sent as the X-Access-Key header.
# It is a master (admin) key: keep it out of index.html / script.js and out of the deployed site.
# In CI it comes from the repository secret BRAINY_API_KEY.
BRAINY_API_KEY=
password=
